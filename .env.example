# File or directory of OpenAPI documents. A directory loads every
# .json, .yaml, and .yml file in it (not subdirectories).
OPENAPI_SPEC_PATH=./specs

# stdio is what Claude Desktop and Cursor use.
# http serves the streamable HTTP transport on MCP_HTTP_ADDR.
MCP_TRANSPORT=stdio
# MCP_HTTP_ADDR=127.0.0.1:8080
